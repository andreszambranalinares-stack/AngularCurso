{
  "name": "angular-curso",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve b2-selector-cantidad",
    "start:b2-selector": "ng serve b2-selector-cantidad",
    "start:b2-2-2": "ng serve b2-carril-b-2-2",
